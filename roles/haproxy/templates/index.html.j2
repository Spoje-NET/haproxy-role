<!DOCTYPE html>
<html lang="cs">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>HAProxy - Domény a služby</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Roboto', 'Oxygen', 'Ubuntu', 'Cantarell', sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }
        .container {
            background: white;
            border-radius: 10px;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
            max-width: 900px;
            width: 100%;
            padding: 40px;
        }
        h1 {
            color: #333;
            margin-bottom: 10px;
            text-align: center;
        }
        .subtitle {
            text-align: center;
            color: #666;
            margin-bottom: 30px;
            font-size: 14px;
        }
        .services-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
            gap: 20px;
        }
        .service-card {
            background: #f8f9fa;
            border: 1px solid #e9ecef;
            border-radius: 8px;
            padding: 20px;
            text-decoration: none;
            color: #333;
            transition: all 0.3s ease;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }
        .service-card:hover {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            border-color: #667eea;
            transform: translateY(-5px);
            box-shadow: 0 10px 25px rgba(102, 126, 234, 0.4);
        }
        .service-name {
            font-weight: 600;
            margin-bottom: 8px;
            word-break: break-all;
            font-size: 14px;
        }
        .service-address {
            font-size: 12px;
            opacity: 0.7;
            margin-bottom: 10px;
            word-break: break-all;
        }
        .service-link {
            display: inline-block;
            margin-top: auto;
            padding: 8px 12px;
            background: rgba(102, 126, 234, 0.1);
            border-radius: 4px;
            font-size: 12px;
            text-align: center;
            font-weight: 500;
        }
        .service-card:hover .service-link {
            background: rgba(255, 255, 255, 0.3);
        }
        .category {
            margin-bottom: 40px;
        }
        .category-title {
            font-size: 18px;
            font-weight: 600;
            color: #667eea;
            margin-bottom: 15px;
            padding-bottom: 10px;
            border-bottom: 2px solid #e9ecef;
        }
        .footer {
            text-align: center;
            margin-top: 30px;
            padding-top: 20px;
            border-top: 1px solid #e9ecef;
            font-size: 12px;
            color: #999;
        }
    </style>
</head>
<body>
    <div class="container">
        <h1>🔗 HAProxy Services</h1>
        <p class="subtitle">Přehled dostupných služeb a domén</p>

        <div class="category">
            <div class="category-title">proxy.spojenet.cz</div>
            <div class="services-grid">
{% for backend in haproxy_backend_servers | selectattr('name', 'match', '.*\\.proxy\\.spojenet\\.cz$') | list %}
                <a href="https://{{ backend.name }}" class="service-card" title="Kliknout pro otevření {{ backend.name }}">
                    <div>
                        <div class="service-name">{{ backend.name.replace('.proxy.spojenet.cz', '') }}</div>
                        <div class="service-address">{{ backend.address }}</div>
                    </div>
                    <div class="service-link">→ Přejít</div>
                </a>
{% endfor %}
            </div>
        </div>

        <div class="category">
            <div class="category-title">spojenet.cz</div>
            <div class="services-grid">
{% for backend in haproxy_backend_servers | selectattr('name', 'match', '.*\\.spojenet\\.cz$') | reject('match', 'name', '.*\\.proxy\\.spojenet\\.cz$') | list %}
                <a href="https://{{ backend.name }}" class="service-card" title="Kliknout pro otevření {{ backend.name }}">
                    <div>
                        <div class="service-name">{{ backend.name.replace('.spojenet.cz', '') }}</div>
                        <div class="service-address">{{ backend.address }}</div>
                    </div>
                    <div class="service-link">→ Přejít</div>
                </a>
{% endfor %}
            </div>
        </div>

        <div class="category">
            <div class="category-title">vitexsoftware.com</div>
            <div class="services-grid">
{% for backend in haproxy_backend_servers | selectattr('name', 'match', '.*\\.vitexsoftware\\.com$') | list %}
                <a href="https://{{ backend.name }}" class="service-card" title="Kliknout pro otevření {{ backend.name }}">
                    <div>
                        <div class="service-name">{{ backend.name.replace('.vitexsoftware.com', '') }}</div>
                        <div class="service-address">{{ backend.address }}</div>
                    </div>
                    <div class="service-link">→ Přejít</div>
                </a>
{% endfor %}
            </div>
        </div>

        <div class="category">
            <div class="category-title">Ostatní domény</div>
            <div class="services-grid">
{% for backend in haproxy_backend_servers | reject('match', 'name', '.*\\.proxy\\.spojenet\\.cz$|.*\\.spojenet\\.cz$|.*\\.vitexsoftware\\.com$') | list %}
                <a href="https://{{ backend.name }}" class="service-card" title="Kliknout pro otevření {{ backend.name }}">
                    <div>
                        <div class="service-name">{{ backend.name }}</div>
                        <div class="service-address">{{ backend.address }}</div>
                    </div>
                    <div class="service-link">→ Přejít</div>
                </a>
{% endfor %}
            </div>
        </div>

        <div class="footer">
            <p>Generated by HAProxy Ansible Role | {{ ansible_date_time.iso8601 if ansible_date_time is defined else 'HAProxy Services' }}</p>
        </div>
    </div>
</body>
</html>
